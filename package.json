{
  "name": "inkline",
  "version": "1.0.1",
  "private": true,
  "description": "An Obsidian plugin for drawing symbols that no font has and writing with them inline in your notes like characters.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "dev": "node scripts/build.ts --watch",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && tsc -p test && tsc -p test/e2e && tsc -p scripts && tsc -p docs/.vitepress",
    "test": "vitest run",
    "test:e2e": "wdio run test/e2e/wdio.conf.mts",
    "test:e2e:docker": "node scripts/e2e-docker.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "check:pinned": "node scripts/pinned.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build && npm run docs:build",
    "version": "node scripts/release.ts sync && git add manifest.json versions.json"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.2",
    "@wdio/cli": "10.2.0",
    "@wdio/globals": "10.2.0",
    "@wdio/local-runner": "10.2.0",
    "@wdio/mocha-framework": "10.2.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.5.1",
    "fflate": "0.8.3",
    "globals": "17.14.0",
    "mdast-util-from-markdown": "2.1.0",
    "obsidian": "1.14.4",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitepress": "2.0.0-alpha.21",
    "vitest": "5.1.0",
    "wdio-obsidian-reporter": "3.5.0",
    "wdio-obsidian-service": "3.5.0",
    "webdriverio": "10.2.0"
  },
  "allowScripts": {
    "esbuild": true,
    "edgedriver": false,
    "geckodriver": false,
    "classic-level": false
  }
}
